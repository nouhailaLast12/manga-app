{
  "rewrites": [
    {
      "source": "/api/mangadex/:path*",
      "destination": "https://api.mangadex.org/:path*"
    },
    {
      "source": "/api/uploads/:path*",
      "destination": "https://uploads.mangadex.org/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}